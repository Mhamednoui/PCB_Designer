{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parts registry record (docs/design/P1_PARTS_REGISTRY.md)",
  "type": "object",
  "$defs": {
    "datum": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": [
            "number",
            "string",
            "null"
          ],
          "pattern": "^ratio:[0-9.]+\\*vdd([+-][0-9.]+)?$"
        },
        "typ": {
          "type": [
            "number",
            "string",
            "null"
          ],
          "pattern": "^ratio:[0-9.]+\\*vdd([+-][0-9.]+)?$"
        },
        "max": {
          "type": [
            "number",
            "string",
            "null"
          ],
          "pattern": "^ratio:[0-9.]+\\*vdd([+-][0-9.]+)?$"
        },
        "unit": {
          "type": "string"
        },
        "at": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          }
        },
        "cond": {
          "type": "string"
        },
        "src": {
          "type": "string"
        },
        "illustrative": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "pinelec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "power_in",
            "power_out",
            "input",
            "output",
            "bidirectional",
            "open_collector",
            "passive",
            "analog",
            "nc",
            "unspecified"
          ]
        },
        "abs_max": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v_min": {
              "type": [
                "number",
                "null"
              ]
            },
            "v_max": {
              "type": [
                "number",
                "string",
                "null"
              ],
              "pattern": "^pin:[A-Za-z0-9]+[+-][0-9.]+$"
            },
            "i_ma": {
              "type": [
                "number",
                "null"
              ]
            },
            "src": {
              "type": "string"
            },
            "illustrative": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "supply_pin": {
          "type": "string"
        },
        "tristate": {
          "type": "boolean"
        },
        "vih": {
          "$ref": "#/$defs/datum"
        },
        "vil": {
          "$ref": "#/$defs/datum"
        },
        "voh": {
          "$ref": "#/$defs/datum"
        },
        "vol": {
          "$ref": "#/$defs/datum"
        },
        "i_out_max_ma": {
          "$ref": "#/$defs/datum"
        },
        "i_in_leak": {
          "$ref": "#/$defs/datum"
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "required": ["id", "kind", "verification", "kicad", "pins"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "kind": {"enum": ["part", "generic", "connector", "mechanical"]},
    "mpn": {"type": "string"},
    "manufacturer": {"type": "string"},
    "status": {"enum": ["draft", "verified", "obsolete"]},
    "verification": {"enum": ["unverified", "crosschecked", "verified"]},
    "source": {"type": "string"},
    "lcsc": {"type": "object", "properties": {
      "id": {"type": "string", "pattern": "^C[0-9]+$"},
      "class": {"enum": ["basic", "preferred", "extended"]}}},
    "sourcing": {"type": "object", "properties": {
      "stock": {"type": "integer", "minimum": 0},
      "price_1": {"type": "number", "minimum": 0},
      "snapshot_date": {"type": "string"},
      "lifecycle": {"type": "string"}}},
    "package": {"type": "object", "required": ["name", "mount"], "properties": {
      "name": {"type": "string"},
      "mount": {"enum": ["tht", "smd"]},
      "lcsc_package": {"type": "string"},
      "body_mm": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 3}}},
    "kicad": {"type": "object", "required": ["symbol", "footprint"], "properties": {
      "symbol": {"type": "string"},
      "footprint": {"type": "string"},
      "model3d": {"type": "string"},
      "fp_pad_copies": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 2}}}},
    "tht": {"type": "object", "properties": {
      "lead_d_mm": {"type": "number", "minimum": 0},
      "lead_mm": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 2, "maxItems": 2}}},
    "polarity": {"type": "object", "properties": {
      "polarised": {"type": "boolean"},
      "pin1": {"type": "string"},
      "pin1_footprint_marker": {"type": "string"}}},
    "ratings": {"type": "object", "properties": {
      "v_op": {"type": "array", "items": {"type": ["number", "null"]}, "minItems": 2, "maxItems": 2},
      "i_max": {"type": "number"},
      "p_max_mw": {"type": "number"},
      "t_op_c": {"type": "array", "items": {"type": ["number", "null"]}, "minItems": 2, "maxItems": 2}}},
    "value_range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "orderable_as": {"type": "object", "additionalProperties": {"type": "string"}},
    "unverified_dims": {"type": "array", "items": {"type": "string"}},
    "footprint_aliases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "lcsc_package_aliases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "pins": {"type": "object", "patternProperties": {
      "^[A-Za-z0-9]+$": {"type": "object", "required": ["name"], "properties": {
        "name": {"type": "string"},
        "alias": {"type": "string"},
        "also": {"type": "string"},
        "class": {"enum": ["power_in", "power_out", "input", "output", "bidirectional",
                           "open_collector", "passive", "analog", "nc", "unspecified"]},
        "abs_max": {"type": "object", "properties": {
          "v_min": {"type": ["number", "null"]},
          "v_max": {"type": ["number", "string", "null"], "pattern": "^pin:[A-Za-z0-9]+[+-][0-9.]+$"},
          "i_ma": {"type": ["number", "null"]}}}}}},
      "additionalProperties": false},
    "evidence": {"type": "array", "items": {"type": "object", "properties": {
      "section": {"type": "string"}, "doc_url": {"type": "string"}, "page": {"type": ["string", "integer"]},
      "rev": {"type": "string"}, "method": {"type": "string"}, "verified_by": {"type": "string"},
      "date": {"type": "string"}, "notes": {"type": "string"}}}},
    "electrical": {
      "type": "object",
      "additionalProperties": false,
      "description": "Electrical data for the P2 analyzer (docs/design/P2_ELECTRICAL_ANALYZER.md 2, 4.3). UNSIGNED: not in parts.SIGNED_FIELDS. The signature (ADR 0006) attests pin identity (names, numbers, pads) which a tool can crosscheck; electrical numbers are read from a datasheet by an agent and need a person's sign-off that no tool can give, so signing them would make a crosscheck tier claim it does not earn, and adding them to the signed set would drop every crosschecked record to unverified. Each number carries its own `src` (URL + page + revision) instead; a number with neither `src` nor `illustrative: true` is rejected by validate(). A value that could not be cited is null and listed in `gaps`; it is never guessed. electrical.pins.<pad>.class/abs_max override the legacy pins.<pad>.class/abs_max (which are signed and may be illustrative) when both exist.",
      "properties": {
        "value_match": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "family records only: the part values (netlist value) this block covers, e.g. RED; other values are NOT_JUDGED"
        },
        "input_type": {
          "enum": [
            "cmos",
            "ttl",
            "schmitt"
          ]
        },
        "tristate": {
          "type": "boolean"
        },
        "role": {
          "enum": [
            "clamp",
            "rectifier",
            "led",
            "resistor",
            "fuse",
            "regulator",
            "mosfet",
            "optocoupler",
            "logic",
            "mcu",
            "sensor"
          ]
        },
        "pins": {
          "type": "object",
          "patternProperties": {
            "^[A-Za-z0-9]+$": {
              "$ref": "#/$defs/pinelec"
            }
          },
          "additionalProperties": false
        },
        "pin_defaults": {
          "type": "object",
          "patternProperties": {
            "^(power_in|power_out|input|output|bidirectional|open_collector|passive|analog|nc|unspecified)$": {
              "$ref": "#/$defs/pinelec"
            }
          },
          "additionalProperties": false
        },
        "fuse": {
          "type": "object",
          "description": "Series protection element (fuse / PTC): i_hold_ma = current it carries indefinitely, r_max_ohm = maximum series resistance in the untripped state (P2-T6, EL-BUDGET / EL-DROPOUT).",
          "additionalProperties": false,
          "properties": {
            "i_hold_ma": {"$ref": "#/$defs/datum"},
            "i_trip_ma": {"$ref": "#/$defs/datum"},
            "r_max_ohm": {"$ref": "#/$defs/datum"}
          }
        },
        "regulator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "topology": {
              "enum": [
                "ldo",
                "switcher_module"
              ]
            },
            "vin": {
              "$ref": "#/$defs/datum"
            },
            "vout": {
              "$ref": "#/$defs/datum"
            },
            "dropout": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/datum"
              }
            },
            "i_max_ma": {
              "$ref": "#/$defs/datum"
            },
            "i_limit_ma": {
              "$ref": "#/$defs/datum"
            },
            "iq_ma": {
              "$ref": "#/$defs/datum"
            },
            "min_load_ma": {
              "$ref": "#/$defs/datum"
            },
            "efficiency_pct": {
              "$ref": "#/$defs/datum"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "vf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/datum"
          }
        },
        "vth": {
          "$ref": "#/$defs/datum"
        },
        "rds_on": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/datum"
          }
        },
        "ctr_pct": {
          "$ref": "#/$defs/datum"
        },
        "i_f_max_ma": {
          "$ref": "#/$defs/datum"
        },
        "theta_ja": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/datum"
          }
        },
        "tj_max": {
          "$ref": "#/$defs/datum"
        },
        "p_max_mw": {
          "$ref": "#/$defs/datum"
        },
        "load_ma": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "typ": {
              "$ref": "#/$defs/datum"
            },
            "peak": {
              "$ref": "#/$defs/datum"
            }
          }
        },
        "clamp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v_standoff": {
              "$ref": "#/$defs/datum"
            },
            "v_breakdown": {
              "$ref": "#/$defs/datum"
            },
            "v_clamp": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/datum"
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "signed_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
