{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "REQUIREMENTS from netlist.py (P2 design section 5)",
  "description": "Flat union of every kind's keys; which keys each kind needs/allows is enforced by req/eval.py (KINDS). Endpoints are 'ref.pin' (pad number or pin name) or a net name.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "kind", "text"],
    "properties": {
      "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
      "kind": {"type": "string", "enum": ["path", "path_absent", "net_v", "net_i", "rail_peak", "static_logic", "spice"]},
      "text": {"type": "string", "pattern": "[^ ]"},
      "from": {"type": "string"},
      "to": {"type": "string"},
      "through": {"type": ["object", "string"], "additionalProperties": true},
      "with": {"type": "object", "additionalProperties": {"type": "string", "enum": ["on", "off"]}},
      "via_ground": {"type": "boolean"},
      "net": {"type": "string"},
      "min": {"type": "number"},
      "max": {"type": "number"},
      "max_mA": {"type": "number", "minimum": 0},
      "basis": {"type": "string", "enum": ["peak", "typ"]},
      "when": {"type": "object", "additionalProperties": {"type": ["string", "number", "array"]}},
      "expect": {"type": "object", "additionalProperties": {"type": "string", "enum": ["on", "off"]}},
      "scenario": {"type": "string"}
    }
  }
}
