{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "design.json - the design IR (docs/PLATFORM_PLAN.md section 10)",
 "description": "Built by tools/boardgen/ir/build.py. ir_version 2 (v2 adds per-part `electrical`, per-pin `abs_max`/`io`, top-level `external`; P2-T2). Coordinates in mm, KiCad board frame (y down). 'board' is present only when a .kicad_pcb exists. Net names are as in netlist.py (no leading '/').",
 "type": "object",
 "required": [
  "ir_version",
  "meta",
  "parts",
  "nets",
  "assembly",
  "external",
  "fab_profile",
  "requirements"
 ],
 "additionalProperties": false,
 "properties": {
  "ir_version": {
   "enum": [
    2
   ]
  },
  "meta": {
   "type": "object",
   "required": [
    "project",
    "source",
    "git_commit",
    "input_hashes"
   ],
   "additionalProperties": false,
   "properties": {
    "project": {
     "type": "string"
    },
    "source": {
     "enum": [
      "netlist",
      "schematic"
     ]
    },
    "git_commit": {
     "type": [
      "string",
      "null"
     ]
    },
    "input_hashes": {
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    }
   }
  },
  "parts": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "ref",
     "registry",
     "kind",
     "lib_id",
     "footprint",
     "value",
     "lcsc",
     "group",
     "pins",
     "nc",
     "electrical",
     "electrical_status"
    ],
    "additionalProperties": false,
    "properties": {
     "ref": {
      "type": "string",
      "pattern": "^\\S+$"
     },
     "registry": {
      "type": [
       "string",
       "null"
      ]
     },
     "kind": {
      "enum": [
       "part",
       "generic",
       "connector",
       "mechanical",
       "unregistered"
      ]
     },
     "lib_id": {
      "type": "string"
     },
     "footprint": {
      "type": "string"
     },
     "value": {
      "type": "string"
     },
     "lcsc": {
      "type": "string"
     },
     "group": {
      "type": [
       "string",
       "null"
      ]
     },
     "pins": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "required": [
        "name",
        "net",
        "class",
        "abs_max",
        "io"
       ],
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": [
          "string",
          "null"
         ]
        },
        "net": {
         "type": "string"
        },
        "class": {
         "type": [
          "string",
          "null"
         ]
        },
        "abs_max": {
         "type": [
          "object",
          "null"
         ],
         "additionalProperties": false,
         "description": "cited absolute maximums for this pin; null when the record gives none. cited=false means the numbers come from the legacy signed pins.*.abs_max (agent-read / illustrative, not individually cited)",
         "required": [
          "v_min",
          "v_max",
          "i_ma",
          "cited"
         ],
         "properties": {
          "v_min": {
           "type": [
            "number",
            "null"
           ]
          },
          "v_max": {
           "type": [
            "number",
            "string",
            "null"
           ]
          },
          "i_ma": {
           "type": [
            "number",
            "null"
           ]
          },
          "cited": {
           "type": "boolean"
          },
          "src": {
           "type": "string"
          },
          "note": {
           "type": "string"
          }
         }
        },
        "io": {
         "type": [
          "object",
          "null"
         ],
         "additionalProperties": false,
         "description": "logic-level and drive data for the pin (record electrical.pins / pin_defaults)",
         "properties": {
          "supply_pin": {
           "type": "string"
          },
          "tristate": {
           "type": "boolean"
          },
          "vih": {
           "$ref": "#/$defs/datum"
          },
          "vil": {
           "$ref": "#/$defs/datum"
          },
          "voh": {
           "$ref": "#/$defs/datum"
          },
          "vol": {
           "$ref": "#/$defs/datum"
          },
          "i_out_max_ma": {
           "$ref": "#/$defs/datum"
          },
          "i_in_leak": {
           "$ref": "#/$defs/datum"
          },
          "note": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "nc": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "electrical_status": {
      "enum": [
       "none",
       "ok",
       "value_not_covered"
      ],
      "description": "none = no registry record or the record has no electrical block; ok = block present and applies to this value; value_not_covered = family record whose block is limited (value_match) to other values"
     },
     "electrical": {
      "type": [
       "object",
       "null"
      ],
      "additionalProperties": false,
      "description": "part-level electrical data (record electrical minus pins/pin_defaults/value_match); null when electrical_status is none; for value_not_covered only {role, gaps}",
      "properties": {
       "role": {
        "type": "string"
       },
       "input_type": {
        "type": "string"
       },
       "tristate": {
        "type": "boolean"
       },
       "fuse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "i_hold_ma": {"$ref": "#/$defs/datum"},
         "i_trip_ma": {"$ref": "#/$defs/datum"},
         "r_max_ohm": {"$ref": "#/$defs/datum"}
        }
       },
       "regulator": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "topology": {
          "type": "string"
         },
         "vin": {
          "$ref": "#/$defs/datum"
         },
         "vout": {
          "$ref": "#/$defs/datum"
         },
         "dropout": {
          "type": "array",
          "items": {
           "$ref": "#/$defs/datum"
          }
         },
         "i_max_ma": {
          "$ref": "#/$defs/datum"
         },
         "i_limit_ma": {
          "$ref": "#/$defs/datum"
         },
         "iq_ma": {
          "$ref": "#/$defs/datum"
         },
         "min_load_ma": {
          "$ref": "#/$defs/datum"
         },
         "efficiency_pct": {
          "$ref": "#/$defs/datum"
         },
         "note": {
          "type": "string"
         }
        }
       },
       "vf": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/datum"
        }
       },
       "vth": {
        "$ref": "#/$defs/datum"
       },
       "rds_on": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/datum"
        }
       },
       "ctr_pct": {
        "$ref": "#/$defs/datum"
       },
       "i_f_max_ma": {
        "$ref": "#/$defs/datum"
       },
       "theta_ja": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/datum"
        }
       },
       "tj_max": {
        "$ref": "#/$defs/datum"
       },
       "p_max_mw": {
        "$ref": "#/$defs/datum"
       },
       "load_ma": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "typ": {
          "$ref": "#/$defs/datum"
         },
         "peak": {
          "$ref": "#/$defs/datum"
         }
        }
       },
       "clamp": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "v_standoff": {
          "$ref": "#/$defs/datum"
         },
         "v_breakdown": {
          "$ref": "#/$defs/datum"
         },
         "v_clamp": {
          "type": "array",
          "items": {
           "$ref": "#/$defs/datum"
          }
         }
        }
       },
       "gaps": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "note": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "nets": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "v",
     "i_max",
     "class",
     "pins"
    ],
    "additionalProperties": false,
    "properties": {
     "v": {
      "type": [
       "array",
       "null"
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "number"
      }
     },
     "i_max": {
      "type": [
       "number",
       "null"
      ]
     },
     "class": {
      "enum": [
       "power",
       "ground",
       "signal"
      ]
     },
     "pins": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^[^.]+\\..+$"
      }
     }
    }
   }
  },
  "board": {
   "type": "object",
   "required": [
    "layers",
    "stackup",
    "outline",
    "footprints",
    "pads",
    "zones",
    "tracks",
    "vias",
    "holes"
   ],
   "additionalProperties": false,
   "properties": {
    "layers": {
     "type": "object",
     "required": [
      "copper",
      "count"
     ],
     "additionalProperties": false,
     "properties": {
      "copper": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "count": {
       "type": "integer",
       "minimum": 1
      }
     }
    },
    "stackup": {
     "type": "object",
     "required": [
      "thickness_mm",
      "layers"
     ],
     "additionalProperties": false,
     "properties": {
      "thickness_mm": {
       "type": [
        "number",
        "null"
       ]
      },
      "layers": {
       "type": [
        "array",
        "null"
       ],
       "items": {
        "type": "object",
        "required": [
         "name",
         "type",
         "thickness_mm",
         "material"
        ],
        "additionalProperties": false,
        "properties": {
         "name": {
          "type": "string"
         },
         "type": {
          "type": [
           "string",
           "null"
          ]
         },
         "thickness_mm": {
          "type": [
           "number",
           "null"
          ]
         },
         "material": {
          "type": [
           "string",
           "null"
          ]
         }
        }
       }
      }
     }
    },
    "outline": {
     "type": "object",
     "required": [
      "polygon",
      "cutouts",
      "bbox",
      "size_mm",
      "area_mm2"
     ],
     "additionalProperties": false,
     "properties": {
      "polygon": {
       "type": "array",
       "minItems": 3,
       "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "number"
        }
       }
      },
      "cutouts": {
       "type": "array",
       "items": {
        "type": "array",
        "minItems": 3,
        "items": {
         "type": "array",
         "minItems": 2,
         "maxItems": 2,
         "items": {
          "type": "number"
         }
        }
       }
      },
      "bbox": {
       "type": "array",
       "minItems": 4,
       "maxItems": 4,
       "items": {
        "type": "number"
       }
      },
      "size_mm": {
       "type": "array",
       "minItems": 2,
       "maxItems": 2,
       "items": {
        "type": "number"
       }
      },
      "area_mm2": {
       "type": "number"
      }
     }
    },
    "footprints": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": [
       "lib_id",
       "x",
       "y",
       "rot",
       "side",
       "attr"
      ],
      "additionalProperties": false,
      "properties": {
       "lib_id": {
        "type": "string"
       },
       "x": {
        "type": "number"
       },
       "y": {
        "type": "number"
       },
       "rot": {
        "type": "number"
       },
       "side": {
        "enum": [
         "front",
         "back"
        ]
       },
       "attr": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     }
    },
    "pads": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": [
       "ref",
       "pad",
       "type",
       "shape",
       "x",
       "y",
       "layers",
       "drill",
       "net"
      ],
      "additionalProperties": false,
      "properties": {
       "ref": {
        "type": "string"
       },
       "pad": {
        "type": "string"
       },
       "type": {
        "enum": [
         "thru_hole",
         "smd",
         "np_thru_hole",
         "connect"
        ]
       },
       "shape": {
        "type": "string"
       },
       "x": {
        "type": "number"
       },
       "y": {
        "type": "number"
       },
       "layers": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "drill": {
        "type": [
         "number",
         "array",
         "null"
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "number"
        }
       },
       "net": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    },
    "zones": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "net",
       "name",
       "layers",
       "keepout",
       "filled",
       "filled_area_mm2",
       "outline_area_mm2"
      ],
      "additionalProperties": false,
      "properties": {
       "net": {
        "type": [
         "string",
         "null"
        ]
       },
       "name": {
        "type": [
         "string",
         "null"
        ]
       },
       "layers": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "keepout": {
        "type": "boolean"
       },
       "filled": {
        "type": "boolean"
       },
       "filled_area_mm2": {
        "type": "number"
       },
       "outline_area_mm2": {
        "type": "number"
       }
      }
     }
    },
    "tracks": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": [
       "segments",
       "arcs",
       "min_width_mm",
       "total_length_mm",
       "layers"
      ],
      "additionalProperties": false,
      "properties": {
       "segments": {
        "type": "integer",
        "minimum": 0
       },
       "arcs": {
        "type": "integer",
        "minimum": 0
       },
       "min_width_mm": {
        "type": "number"
       },
       "total_length_mm": {
        "type": "number"
       },
       "layers": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     }
    },
    "vias": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "x",
       "y",
       "net",
       "size",
       "drill",
       "layers"
      ],
      "additionalProperties": false,
      "properties": {
       "x": {
        "type": "number"
       },
       "y": {
        "type": "number"
       },
       "net": {
        "type": [
         "string",
         "null"
        ]
       },
       "size": {
        "type": "number"
       },
       "drill": {
        "type": "number"
       },
       "layers": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     }
    },
    "holes": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "diameter",
       "plated",
       "kind",
       "count"
      ],
      "additionalProperties": false,
      "properties": {
       "diameter": {
        "type": [
         "number",
         "array"
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "number"
        }
       },
       "plated": {
        "type": "boolean"
       },
       "kind": {
        "enum": [
         "pad",
         "via"
        ]
       },
       "count": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    }
   }
  },
  "assembly": {
   "type": "object",
   "required": [
    "mode",
    "boards"
   ],
   "additionalProperties": false,
   "properties": {
    "mode": {
     "enum": [
      "pcba",
      "hand",
      null
     ]
    },
    "boards": {
     "type": [
      "integer",
      "null"
     ]
    }
   }
  },
  "fab_profile": {
   "type": "object",
   "required": [
    "name",
    "declared"
   ],
   "additionalProperties": false,
   "properties": {
    "name": {
     "type": "string"
    },
    "declared": {
     "type": "boolean"
    }
   }
  },
  "requirements": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "external": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "declared",
    "pins",
    "none"
   ],
   "description": "EXTERNAL from netlist.py: what the outside world does to connector pins. declared=false when netlist.py has no EXTERNAL at all (P2 reports every connector NOT_JUDGED); EXTERNAL = {} is declared with nothing external. pins: 'ref.pad' -> {v:[min,max]|null, i, dir, why}; none: connector refs declared to have no external nets ('J1': 'none').",
   "properties": {
    "declared": {
     "type": "boolean"
    },
    "classes": {
     "type": "object",
     "description": "connector ref -> {class: expansion, why}: a connector whose unprotected nets are the user's responsibility (EL-CONN-PROT WARN instead of ERROR).",
     "additionalProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "why"],
      "properties": {"class": {"enum": ["expansion"]}, "why": {"type": "string"}}
     }
    },
    "pins": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "v",
       "i",
       "dir",
       "why"
      ],
      "properties": {
       "v": {
        "type": [
         "array",
         "null"
        ],
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       },
       "i": {
        "type": [
         "number",
         "null"
        ],
        "description": "amperes (source capability for a supply, expected load for an input)"
       },
       "dir": {
        "enum": [
         "in",
         "out",
         "bidir",
         "supply",
         null
        ]
       },
       "why": {
        "type": "string"
       }
      }
     }
    },
    "none": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  }
 },
 "$defs": {
  "datum": {
   "type": "object",
   "additionalProperties": false,
   "description": "A cited electrical number copied from the part record (parts/schema.json datum).",
   "properties": {
    "min": {
     "type": [
      "number",
      "string",
      "null"
     ]
    },
    "typ": {
     "type": [
      "number",
      "string",
      "null"
     ]
    },
    "max": {
     "type": [
      "number",
      "string",
      "null"
     ]
    },
    "unit": {
     "type": "string"
    },
    "at": {
     "type": "object",
     "additionalProperties": {
      "type": [
       "number",
       "string"
      ]
     }
    },
    "cond": {
     "type": "string"
    },
    "src": {
     "type": "string"
    },
    "illustrative": {
     "type": "boolean"
    },
    "note": {
     "type": "string"
    }
   }
  }
 }
}
