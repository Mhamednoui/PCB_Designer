# Runtime artifacts - regenerated, never edited by hand
__pycache__/
*.pyc
webview/server/server.log
webview/projects/*/run_log.jsonl
webview/projects/*/capture.vcd
webview/projects/*/model.glb

# KiCad per-user state (the .kicad_pro IS tracked - it holds the design rules)
*.kicad_prl
*-backup/
fp-info-cache

# Generated intermediates from the route stage
projects/*/*-routed.kicad_pcb
projects/*/*-routed.kicad_pro
projects/*/*-routed.kicad_prl
projects/*/out/route.dsn
projects/*/out/route.ses

# Local tool clones and virtualenv
.venv/
tools/freerouting/

# --- Baseline additions (git init) ---
downloads/
# Third-party clones under tools/ (only boardgen/, sym_pins.py, fp_bbox.py are ours)
tools/Fabrication-Toolkit/
tools/InteractiveHtmlBom/
tools/KiKit/
tools/Konnect/
tools/arduino-kicad-library/
tools/awesome-kicad/
tools/easyeda2kicad.py/
tools/freerouting/
tools/kicad-happy/
tools/kicad-mcp-server/
tools/skidl/
tools/skidl_REPL.*

# KiCad / runtime junk
*-backups/
*.lck
~*.lck
.pio/
projects/**/test/spice/*.raw
projects/**/test/spice/*.log
.claude/settings.local.json
.history/

# volatile check outputs (rewritten by every check run)
projects/*/out/drc.json
projects/*/out/erc.json
projects/*/out/netlist.net

# Agent git worktrees (temporary)
.claude/worktrees/

# gerber LVS result (rewritten by every lvs run)
projects/*/out/lvs.json

# Mutation-suite scratch project copies
projects/_mut_*/

# Parts registry: fetched machine data (jlcsearch / EasyEDA), regenerated by tools/parts.py
parts/.cache/

# Parts registry: stage report (rewritten by every parts run)
projects/*/test/parts/

# Incremental pipeline state (per-stage input hashes of the last successful run)
projects/*/.pipeline_cache.json
.toolchain_cache.json
.toolchain_cache.json.tmp

# Per-run reports (PA-6): report.json/html + full stage logs, last 10 kept per project
projects/*/out/run/

# Design IR (PA-1): generated by the `ir` stage, rebuilt on demand
projects/*/out/design.json
projects/*/out/design.json.tmp
