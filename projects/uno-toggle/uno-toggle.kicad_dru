(version 1)
# GENERATED by tools/boardgen/fab_rules.py - do not edit; change NET_SPEC / COPPER_OZ / TEMP_RISE_C
# in gen/netlist.py. JLCPCB 2-layer limits (safer than the fab minimum) + per-net minimum track
# width from NET_SPEC i_max via IPC-2221 (external layer, 10 C rise, 1 oz). KiCad's board-setup
# minimums in the .kicad_pro still apply on top: no custom rule can loosen them.

(rule "jlc_min_track"
  (severity error)
  (constraint track_width (min 0.15mm)))
(rule "jlc_min_clearance"
  (severity error)
  (constraint clearance (min 0.15mm)))
(rule "jlc_annular_min"
  (severity error)
  (condition "A.Type == 'Pad'")
  (constraint annular_width (min 0.18mm)))
(rule "jlc_via_annular_min"
  (severity error)
  (condition "A.Type == 'Via'")
  (constraint annular_width (min 0.1mm)))
(rule "jlc_annular_preferred"
  (severity warning)
  (condition "A.Type == 'Pad'")
  (constraint annular_width (min 0.25mm)))
(rule "jlc_hole_to_hole"
  (severity error)
  (condition "A.Type != 'Via' || B.Type != 'Via'")
  (constraint hole_to_hole (min 0.45mm)))
(rule "jlc_via_hole_to_hole"
  (severity error)
  (condition "A.Type == 'Via' && B.Type == 'Via'")
  (constraint hole_to_hole (min 0.2mm)))
(rule "jlc_copper_to_edge"
  (severity error)
  (constraint edge_clearance (min 0.3mm)))
(rule "jlc_silk_text_height"
  (severity warning)
  (condition "A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen'")
  (constraint text_height (min 1mm)))
