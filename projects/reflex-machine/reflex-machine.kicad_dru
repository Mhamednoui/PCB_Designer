(version 1)
# GENERATED by tools/boardgen/fab_rules.py - do not edit; change NET_SPEC / COPPER_OZ / TEMP_RISE_C
# in gen/netlist.py. JLCPCB 2-layer limits (safer than the fab minimum) + per-net minimum track
# width from NET_SPEC i_max via IPC-2221 (external layer, 10 C rise, 1 oz). KiCad's board-setup
# minimums in the .kicad_pro still apply on top: no custom rule can loosen them.

(rule "jlc_min_track"
  (severity error)
  (constraint track_width (min 0.15mm)))
(rule "jlc_min_clearance"
  (severity error)
  (constraint clearance (min 0.15mm)))
(rule "jlc_annular_min"
  (severity error)
  (condition "A.Type == 'Pad'")
  (constraint annular_width (min 0.18mm)))
(rule "jlc_via_annular_min"
  (severity error)
  (condition "A.Type == 'Via'")
  (constraint annular_width (min 0.1mm)))
(rule "jlc_annular_preferred"
  (severity warning)
  (condition "A.Type == 'Pad'")
  (constraint annular_width (min 0.25mm)))
(rule "jlc_hole_to_hole"
  (severity error)
  (condition "A.Type != 'Via' || B.Type != 'Via'")
  (constraint hole_to_hole (min 0.45mm)))
(rule "jlc_via_hole_to_hole"
  (severity error)
  (condition "A.Type == 'Via' && B.Type == 'Via'")
  (constraint hole_to_hole (min 0.2mm)))
(rule "jlc_copper_to_edge"
  (severity error)
  (constraint edge_clearance (min 0.3mm)))
(rule "jlc_silk_text_height"
  (severity warning)
  (condition "A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen'")
  (constraint text_height (min 1mm)))

# Current-carrying nets: minimum track width = IPC-2221 for NET_SPEC i_max.
# A net with a copper pour on the board carries its total current in the pour, not in every
# stub, so its rule is only a WARNING. fabreport lists those nets for review; they are not dropped.
# +12V: i_max 10 A, poured on F.Cu -> warning
(rule "current__12V"
  (severity warning)
  (condition "A.NetName == '+12V'")
  (constraint track_width (min 7.2mm)))
(rule "current__12V_IN"
  (severity error)
  (condition "A.NetName == '/+12V_IN'")
  (constraint track_width (min 7.2mm)))
(rule "current__12V_REG"
  (severity error)
  (condition "A.NetName == '/+12V_REG'")
  (constraint track_width (min 0.31mm)))
(rule "current__5V"
  (severity error)
  (condition "A.NetName == '+5V'")
  (constraint track_width (min 0.79mm)))
# GND: i_max 10 A, poured on F.Cu+B.Cu -> warning
(rule "current_GND"
  (severity warning)
  (condition "A.NetName == 'GND'")
  (constraint track_width (min 7.2mm)))
(rule "current_MAG10_OUT"
  (severity error)
  (condition "A.NetName == '/MAG10_OUT'")
  (constraint track_width (min 0.53mm)))
(rule "current_MAG1_OUT"
  (severity error)
  (condition "A.NetName == '/MAG1_OUT'")
  (constraint track_width (min 0.53mm)))
(rule "current_MAG2_OUT"
  (severity error)
  (condition "A.NetName == '/MAG2_OUT'")
  (constraint track_width (min 0.53mm)))
(rule "current_MAG3_OUT"
  (severity error)
  (condition "A.NetName == '/MAG3_OUT'")
  (constraint track_width (min 0.53mm)))
(rule "current_MAG4_OUT"
  (severity error)
  (condition "A.NetName == '/MAG4_OUT'")
  (constraint track_width (min 0.53mm)))
(rule "current_MAG5_OUT"
  (severity error)
  (condition "A.NetName == '/MAG5_OUT'")
  (constraint track_width (min 0.53mm)))
(rule "current_MAG6_OUT"
  (severity error)
  (condition "A.NetName == '/MAG6_OUT'")
  (constraint track_width (min 0.53mm)))
(rule "current_MAG7_OUT"
  (severity error)
  (condition "A.NetName == '/MAG7_OUT'")
  (constraint track_width (min 0.53mm)))
(rule "current_MAG8_OUT"
  (severity error)
  (condition "A.NetName == '/MAG8_OUT'")
  (constraint track_width (min 0.53mm)))
(rule "current_MAG9_OUT"
  (severity error)
  (condition "A.NetName == '/MAG9_OUT'")
  (constraint track_width (min 0.53mm)))
